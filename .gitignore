# Data and artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

# Submissions and generated predictions
submission*.csv
**/submission*.csv
!sample_submission*.csv
!**/sample_submission*.csv
*.tmp
*.pred

# Sandbox temporary executions
sandbox/workspace/*
!sandbox/workspace/.gitkeep

# Environment variables
.env
.env.*

# Python cache, testing and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# IDE and OS
.vscode/
.idea/
.DS_Store
*.log
automl_agent.log
**/automl_agent.log

# Ollama and local model keys
.ollama/
*.key
*.pem
id_ed25519*
id_rsa*

# ML artifacts, checkpoints, cache and training logs
AutogluonModels/
**/AutogluonModels/
.flaml/
mlruns/
catboost_info/
data/.cache/
lightning_logs/
wandb/

# Serialized models and weights
*.pkl
*.joblib
*.pt
*.pth
*.onnx

# Large documents & presentations
*.pdf
